# Copier en .env pour surcharger la configuration (préfixe AEGIS_).

# --- Stockage ---------------------------------------------------------------
# SQLite par défaut ; bascule vers PostgreSQL sans changement de code :
# AEGIS_DATABASE_URL=postgresql+psycopg://aegis:motdepasse@localhost/aegis

# --- API --------------------------------------------------------------------
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8000
# À CHANGER en production : signe les jetons de session.
AEGIS_JWT_SECRET=change-me-in-production

# --- Démarrage automatique d'une source --------------------------------------
# AEGIS_AUTOSTART=lab
# AEGIS_AUTOSTART_SPEED=6

# --- Point de fonctionnement de la détection ---------------------------------
# Le score étant un percentile du trafic normal, 0.98 se lit « alerter au-delà
# de ce qui est plus inhabituel que 98 % du trafic connu de cet hôte ».
# AEGIS_BASE_THRESHOLD=0.98
# AEGIS_HOST_QUANTILE=0.99
# AEGIS_DEDUP_WINDOW=60
